package openai

import std.core.Exception

public value Message { String id String text String? refusal = null }
public value ToolResult { ToolCall call String output }
public value ToolFailure { ToolCall call Exception error }

public enum GenerationEvent {
  ResponseStarted(String id),
  MessageStarted(String id),
  Text(String text),
  MessageCompleted(Message message),
  ToolCallReceived(ToolCall call),
  ToolStarted(ToolCall call),
  ToolCompleted(ToolResult result),
  ToolFailed(ToolFailure failure),
  ResponseCompleted(Response response),
  Failed(Exception error),
  RunStarted(String input),
  RunCompleted(Response response)
}

public class GenerationCallbacks {
  Function<Void(String)>? onResponseStarted = null
  Function<Void(String)>? onMessageStarted = null
  Function<Void(String)>? onText = null
  Function<Void(Message)>? onMessageCompleted = null
  Function<Void(ToolCall)>? onToolCallReceived = null
  Function<Void(ToolCall)>? onToolStarted = null
  Function<Void(ToolResult)>? onToolCompleted = null
  Function<Void(ToolFailure)>? onToolFailed = null
  Function<Void(Response)>? onResponseCompleted = null
  Function<Void(Exception)>? onFailed = null
  Function<Void(String)>? onRunStarted = null
  Function<Void(Response)>? onRunCompleted = null
  Function<Void(GenerationEvent)>? onEvent = null

  public Void emit(GenerationEvent event) {
    var all = onEvent
    if all != null { all(event) }
    switch event {
      case ResponseStarted(String id) { var callback = onResponseStarted if callback != null { callback(id) } }
      case MessageStarted(String id) { var callback = onMessageStarted if callback != null { callback(id) } }
      case Text(String text) { var callback = onText if callback != null { callback(text) } }
      case MessageCompleted(Message message) { var callback = onMessageCompleted if callback != null { callback(message) } }
      case ToolCallReceived(ToolCall call) { var callback = onToolCallReceived if callback != null { callback(call) } }
      case ToolStarted(ToolCall call) { var callback = onToolStarted if callback != null { callback(call) } }
      case ToolCompleted(ToolResult result) { var callback = onToolCompleted if callback != null { callback(result) } }
      case ToolFailed(ToolFailure failure) { var callback = onToolFailed if callback != null { callback(failure) } }
      case ResponseCompleted(Response response) { var callback = onResponseCompleted if callback != null { callback(response) } }
      case Failed(Exception error) { var callback = onFailed if callback != null { callback(error) } }
      case RunStarted(String input) { var callback = onRunStarted if callback != null { callback(input) } }
      case RunCompleted(Response response) { var callback = onRunCompleted if callback != null { callback(response) } }
    }
  }
}
