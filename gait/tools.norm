package gait

import std.core.Exception
import openai.Tool
import openai.ToolParameter

public enum ActionKind { Status, CreateBranch, SwitchBranch, CreateAndSwitch, Diff, ReadFiles, SummarizeFile, Stage, Commit }

public value Action {
  ActionKind kind
  String branch = ""
  List<String> paths = []
  String message = ""
  Boolean staged = false
  Integer startLine = 1
  Integer lineCount = 80
}

public class AgentTools {
  private String directory
  private String userMessages
  private Git? git = null
  private Observation? observation = null

  AgentTools(String directory, String userMessages) {
    this.directory = directory
    this.userMessages = userMessages
  }

  public List<Function<?>> functions() {
    return [this.status, this.summarize, this.diff, this.createBranch, this.switchBranch,
      this.createAndSwitch, this.stage, this.readFiles, this.commit, this.configureModel]
  }

  @Tool(name: "git_status", description: "Read the current repository status. Use before planning repository changes.")
  public String status() {
    return this.perform(action: Action(kind: ActionKind.Status))
  }

  @Tool(name: "git_diff", description: "Read staged or unstaged changes. Empty paths means all tracked changes in that scope.")
  public String diff(List<String> paths, Boolean staged) {
    return this.perform(action: Action(kind: ActionKind.Diff, paths: paths, staged: staged))
  }

  @Tool(name: "git_create_branch", description: "Create a branch without switching.")
  public String createBranch(String branch) {
    return this.perform(action: Action(kind: ActionKind.CreateBranch, branch: branch))
  }

  @Tool(name: "git_switch_branch", description: "Switch to an existing local branch.")
  public String switchBranch(String branch) {
    return this.perform(action: Action(kind: ActionKind.SwitchBranch, branch: branch))
  }

  @Tool(name: "git_create_and_switch", description: "Create a branch and switch to it.")
  public String createAndSwitch(String branch) {
    return this.perform(action: Action(kind: ActionKind.CreateAndSwitch, branch: branch))
  }

  @Tool(name: "git_stage", description: "Stage specified repository-relative paths authorized by the user. Does not commit.")
  public String stage(List<String> paths) {
    return this.perform(action: Action(kind: ActionKind.Stage, paths: paths))
  }

  @Tool(name: "git_read_files", description: "Read a page from up to 8 tracked or non-ignored untracked files. Defaults: startLine=1, lineCount=80; maximum lineCount=200. Lines are additions from empty. next_line=0 means EOF; otherwise use it only when further detail is necessary. Binary files are identified. Do not reread a page already inspected.")
  public String readFiles(List<String> paths, Integer startLine = 1, Integer lineCount = 80) {
    return this.perform(action: Action(kind: ActionKind.ReadFiles, paths: paths, startLine: startLine, lineCount: lineCount))
  }

  @Tool(name: "git_commit", description: "Commit the current index as one batch using the supplied non-empty message. Returns the verified commit hash and resulting repository status.")
  public String commit(String message) {
    return this.perform(action: Action(kind: ActionKind.Commit, message: message))
  }

  @Tool(name: "git_summarize_file", description: "Preferred tool for understanding ONE repository file. A separate model call reads its full bounded content and returns a concise summary, keeping raw source out of the main context. Set focus to the question or summarization angle, e.g. commit theme, interfaces, or tests. Does not inspect the actual Git diff or execute operations.")
  public String summarize(String path, @ToolParameter(description: "The question or summarization angle") String? focus) {
    Git current = git ?? Git(directory: directory)
    git = current
    return summarizeFile(git: current, path: path, focus: focus ?? "文件用途、关键行为、依赖与相关测试").render(json: true)
  }

  @Tool(name: "configure", description: "Test and save the user's model configuration. Empty strings keep effective values. New credentials and endpoints must be supplied by the user. No Git repository required.")
  public String configureModel(String apiKey, String model, String endpoint) {
    UserConfig previous = loadConfiguration()
    if !apiKey.isEmpty() && apiKey != previous.effective.apiKey && !userMessages.contains(value: apiKey) { throw Problem(code: "INVALID_ARGUMENT", message: "新密钥必须来自用户消息。") }
    if !model.isEmpty() && model != previous.effective.model && !userMessages.contains(value: model) { throw Problem(code: "INVALID_ARGUMENT", message: "新模型名称必须来自用户消息。") }
    String address = endpoint
    if address.endsWith(suffix: "/responses") { address = address.sliceCodePoints(start: 0, end: address.codePointSize() - 10) }
    if !endpoint.isEmpty() && responsesEndpoint(address: endpoint) != previous.effective.endpoint && !userMessages.contains(value: address) { throw Problem(code: "INVALID_ARGUMENT", message: "新接口地址必须来自用户消息。") }
    return configure(candidate: AiConfig(apiKey: if apiKey.isEmpty() { previous.effective.apiKey } else { apiKey },
      model: if model.isEmpty() { previous.effective.model } else { model },
      endpoint: if endpoint.isEmpty() { previous.effective.endpoint } else { endpoint }), previous: previous).render(json: true)
  }

  private String perform(Action action) {
    try {
      Git current = git ?? Git(directory: directory)
      git = current
      ActionKind kind = action.kind
      Observation initial = if kind == ActionKind.Status { current.observe(detailed: true) } else { observation ?? current.observe(detailed: true) }
      Report result = execute(git: current, action: action, initial: initial)
      observation = if kind == ActionKind.Status { initial } else { if kind == ActionKind.Diff || kind == ActionKind.ReadFiles { current.observe(detailed: true) } else { null } }
      return result.render(json: true)
    } catch Exception error { observation = null throw error }
  }
}
